// Credit Comp Platform — V1 shell schema
// The comp language mirrors the team's existing comp-analysis doctrine
// (see "Comp Analysis Instructions.md" in the project folder):
//   · Every metric is VERBATIM from its source — nothing derived or backed
//     into. A source that doesn't state a value leaves the field null, and
//     the UI renders an em dash.
//   · Occupancy is always current / in-place — never stabilized or projected.
//   · Two categories: BRIDGE_REFI (built, existing) and CONSTRUCTION (not
//     built / needs to be built). A subject only matches comps in its bucket.
//   · Crow's position in the stack comes from the internal record, never
//     inferred from an OM.
// Doctrines carried over from the Industrial platform: nothing hard-deleted,
// every record attributed to a real person.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────── ENUMS ───────────────────────────────

enum Role {
  ANALYST
  ADMIN
}

// INDUSTRIAL deliberately absent — industrial comps live in the sister
// Industrial platform and are never used on the Credit site (Mason, 9/21/26).
enum PropertyType {
  MULTIFAMILY
  OFFICE
  RETAIL
  HOTEL
  SELF_STORAGE
  SENIOR_HOUSING
  STUDENT_HOUSING
  MIXED_USE
  LAND
  OTHER
  UNKNOWN
}

/// Two deal categories (simplified from A/B/C/D/GE by Mason, 9/21/26).
/// The asset's stage decides it — what the OM asks for is recorded
/// separately (crowPosition, loan terms) and does not drive screening.
enum DealCategory {
  BRIDGE_REFI // property is built and exists (former A + B)
  CONSTRUCTION // not built / needs to be built (former C + D + GE)
}

/// Crow's position in the capital stack — from the internal deal record,
/// never inferred from the OM.
enum CrowPosition {
  MEZZANINE
  STRETCH_SENIOR
  WHOLE_LOAN
  PREFERRED_EQUITY
  LP_EQUITY
  OTHER
}

enum RateType {
  FIXED
  FLOATING
}

enum DealOutcome {
  SCREENED // looked at, no quote issued
  QUOTED
  CLOSED
  PASSED
  LOST // quoted, lost to a competing lender
}

// ─────────────────────────────── MODELS ───────────────────────────────

model User {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  role      Role         @default(ANALYST)
  active    Boolean      @default(true) // users are deactivated, never deleted
  createdAt DateTime     @default(now())
  comps     CreditComp[]
}

/// One past deal the team has underwritten — the credit "comp".
/// All financial fields are nullable on purpose: verbatim-or-null doctrine.
model CreditComp {
  id       String  @id @default(cuid())
  dealName String? // internal deal name, if any

  // ── Property & market ──
  propertyName String?
  address      String?
  city         String?
  state        String?
  zip          String? // location filter #1 works zip-first
  lat          Float? // zip-centroid coords, geocoded lazily and cached (radius filter)
  lon          Float?
  market       String
  submarket    String?
  propertyType PropertyType @default(UNKNOWN)
  units        Int? // multifamily
  stories      Int? // number of stories (filterable)
  sizeSf       Int? // NRA / commercial SF
  yearBuilt    Int?
  occupancyPct Float? // CURRENT / in-place only — null for pre-delivery assets

  // ── Classification ──
  category     DealCategory?
  crowPosition CrowPosition?

  // ── Loan terms (verbatim from source; null when not stated) ──
  loanAmount       Float? // total / requested loan amount
  loanPerUnit      Float? // stated, never computed
  loanPerSf        Float? // stated, never computed
  rateType         RateType?
  indexName        String? // e.g. "SOFR" when floating
  spreadBps        Int? // over the index, when floating
  ratePct          Float? // all-in / fixed rate, stored as fraction (0.0685)
  termMonths       Int?
  ioMonths         Int?
  originationDate  DateTime?

  // ── Credit metrics (verbatim; fractions 0–1 for percents) ──
  ltvPct           Float?
  ltcPct           Float?
  dscr             Float?
  debtYieldPct     Float? // suppressed on development deals in analysis
  totalProjectCost Float?
  tpcPerUnit       Float? // stated, never computed
  impliedCapPct    Float?
  stabilizedCapPct Float?

  // ── Parties & outcome ──
  borrowerSponsor String?
  brokerage       String?
  outcome         DealOutcome @default(SCREENED)
  outcomeNote     String? // pricing where we landed / why we passed / who won

  // ── Per-year underwriting metrics (verbatim from the OM's projections) ──
  metricYears CompMetricYear[]

  // ── Provenance ──
  sourceKey   String? @unique // stable id for the build-time import (hash of source file) — never shown
  sourceNote  String? // "OM Index row 14", "term sheet 3/24", broker call…
  omLink      String? // SharePoint link to the underlying OM, if any
  notes       String?
  archived    Boolean  @default(false) // nothing hard-deleted — archive instead
  dupApproved Boolean  @default(false) // Mason reviewed a duplicate flag and kept this row
  enteredById String?
  enteredBy   User?    @relation(fields: [enteredById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses DealAnalysis[]

  @@index([market])
  @@index([propertyType])
  @@index([category])
  @@index([zip])
  @@index([state, city])
}

/// DSCR and Debt Yield as the OM states them, per projection year
/// ("Year 1", "Year 2", "Year 3", "Stabilized"). Verbatim-or-null —
/// a year the OM doesn't quote simply has no row.
model CompMetricYear {
  id           String     @id @default(cuid())
  compId       String
  comp         CreditComp @relation(fields: [compId], references: [id], onDelete: Cascade)
  yearLabel    String // "Year 1" | "Year 2" | "Year 3" | "Stabilized" | ...
  dscr         Float?
  debtYieldPct Float? // fraction (0.085 = 8.5%)

  @@unique([compId, yearLabel])
  @@index([yearLabel])
}

/// A saved New Deal Analysis. The subject deal is ITSELF a CreditComp row
/// (auto-added on save — Mason, 9/21/26), so it screens as a comp for every
/// future deal. The matched set and stats are snapshotted for reproducibility.
model DealAnalysis {
  id           String     @id @default(cuid())
  subjectId    String
  subject      CreditComp @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  locationMode String // "zip" | "city" | "none"
  matchedCount Int
  snapshot     Json // { matchedIds, trace, stats } as computed at save time
  createdBy    String? // signed-in user's name
  createdAt    DateTime   @default(now())

  @@index([createdAt])
}
